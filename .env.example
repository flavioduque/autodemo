# Where the recorded browser may send bytes. Strict allowlist: anything not
# listed is refused — first navigation, redirects, links, fetch/XHR, iframes,
# WebSockets. Unset or empty = "localhost,127.0.0.1,::1" (every port).
#
# Entries, comma-separated:
#   host          exact hostname or IP literal, any port     e.g. localhost
#   host:port     pinned to one port                         e.g. 127.0.0.1:5173
#   [::1]:port    IPv6 with a port needs brackets; bare ::1 needs none
#
# A hostname entry also needs the ADDRESSES it resolves to listed — the policy
# decides on addresses, so a name that starts resolving elsewhere is refused.
# No wildcards (".example.com"): they cannot be resolved and pinned at start.
# Every session resolves the names ONCE and pins the browser to those answers.
# See SECURITY.md.
# AUTODEMO_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# AUTODEMO_ALLOWED_HOSTS=staging.example.com,203.0.113.7,localhost,127.0.0.1,::1

# Optional Playwright browser channel used for capture sessions.
# Unset (default): use Playwright's bundled Chromium — deterministic, used in CI.
# Set to "chrome" (or "msedge"): drive that locally installed browser instead.
# Use this on hosts where Playwright has no bundled Chromium build available.
# AUTODEMO_BROWSER_CHANNEL=chrome

# HyperFrames anonymous render telemetry. AutoDemo sets this to "1" for the
# render child process by default, so it never phones home on a user's behalf.
# Set it yourself — to any value, including "0" — and your choice is kept.
# HYPERFRAMES_NO_TELEMETRY=1

# Set to "1" to run the slow render-level tests (they launch Chrome and ffmpeg).
# AUTODEMO_RENDER_TESTS=1

# Set to "1" to run the end-to-end MCP protocol test: it spawns the server as a
# child process and speaks JSON-RPC over stdio, driving a real capture, edit and
# render twice. Slow (a few minutes) and needs Chrome + ffmpeg.
# AUTODEMO_E2E_TESTS=1

# Set to "1" alongside the above to forward the spawned server's stderr, which
# is the only way to see where a wire test is stuck.
# AUTODEMO_E2E_DEBUG=1
