{
  "name": "demomotion-mcp",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r --no-bail build",
    "dev:mcp": "pnpm --filter @demomotion/mcp-server dev",
    "studio": "pnpm --filter @demomotion/studio studio",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail --if-present test",
    "fixture": "node fixtures/target-app/server.mjs",
    "showcase": "node fixtures/showcase-app/server.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
