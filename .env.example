# Optional comma-separated host allowlist. Empty = unrestricted.
DEMOMOTION_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional Playwright browser channel used for capture sessions.
# Unset (default): use Playwright's bundled Chromium — deterministic, used in CI.
# Set to "chrome" (or "msedge"): drive that locally installed browser instead.
# Use this on hosts where Playwright has no bundled Chromium build available.
# DEMOMOTION_BROWSER_CHANNEL=chrome

# HyperFrames anonymous render telemetry. DemoMotion sets this to "1" for the
# render child process by default, so it never phones home on a user's behalf.
# Set it yourself — to any value, including "0" — and your choice is kept.
# HYPERFRAMES_NO_TELEMETRY=1

# Set to "1" to run the slow render-level tests (they launch Chrome and ffmpeg).
# DEMOMOTION_RENDER_TESTS=1
